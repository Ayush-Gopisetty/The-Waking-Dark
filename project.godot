; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Waking Dark"
config/description="First-person survival horror. Gray-box prototype of the opening."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="doors"
3d_physics/layer_4="interactable"
3d_physics/layer_5="spirit"

[navigation]

3d/default_cell_size=0.125
3d/default_cell_height=0.1

[rendering]

rendering_device/driver.macos="metal"

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
